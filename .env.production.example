# Liara AI Docs Assistant - Production Environment Variables
# Copy to .env.production and fill in actual values

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://docsapp:CHANGE_PASSWORD@postgres:5432/docs_assistant

# ============================================
# ENCRYPTION & SECURITY
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY_CURRENT_VERSION=1
ENCRYPTION_KEY_V1=CHANGE_ME_64_CHAR_HEX

ASSISTANT_HMAC_KEY_CURRENT_VERSION=1
ASSISTANT_HMAC_KEY_V1=CHANGE_ME_64_CHAR_HEX

SESSION_SECRET=CHANGE_ME_64_CHAR_HEX

# ============================================
# ENGINE CONNECTION
# ============================================
ENGINE_API_TOKEN=CHANGE_ME_64_CHAR_HEX
ENGINE_URL=http://docs-engine:3100

# ============================================
# ADMIN CREDENTIALS
# ============================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# ============================================
# ASSISTANT CONFIGURATION
# ============================================
ASSISTANT_ALLOWED_HOSTS=docs.liara.ir,www.docs.liara.ir
ASSISTANT_ALLOWED_ORIGINS=https://docs.liara.ir,https://www.docs.liara.ir
TRUSTED_CLIENT_IP_HEADER=x-liara-client-ip

# AvalAI Configuration
AVALAI_ALLOWED_HOSTS=api.avalai.ir
AVALAI_ALLOWED_MODELS=gpt-4o-mini

# Performance
ASSISTANT_REQUEST_TIMEOUT_MS=45000
ASSISTANT_MAX_CONCURRENCY=20

# ============================================
# DEPLOYMENT
# ============================================
NODE_ENV=production
NEXT_PUBLIC_DEPLOYMENT_ENV=production
