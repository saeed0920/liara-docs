# PostgreSQL connection (Liara DBaaS)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Versioned AES-256-GCM keys. Keep old versions during decrypt-old/encrypt-new rotation.
ENCRYPTION_KEY_CURRENT_VERSION=1
ENCRYPTION_KEY_V1=
# Legacy read-only fallback during migration:
# ENCRYPTION_SECRET=

# Independent HMAC write key; retain key version in aggregate rows across rotation.
ASSISTANT_HMAC_KEY_CURRENT_VERSION=1
ASSISTANT_HMAC_KEY_V1=

# Private retrieval-engine bearer-token overlap. Remove NEXT after rotation.
ENGINE_API_TOKEN=
# ENGINE_API_TOKEN_NEXT=
ENGINE_URL=http://docs-engine.internal:3000

# JWT signing secret for the admin session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=

# Seed admin (created in the DB on first login attempt if not present)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Public request boundary. Use the exact production host and HTTPS origin.
ASSISTANT_ALLOWED_HOSTS=docs.example
ASSISTANT_ALLOWED_ORIGINS=https://docs.example

# Must be the explicit non-forwarded client-IP header approved by Liara.
TRUSTED_CLIENT_IP_HEADER=x-liara-client-ip

# Server-only provider policy. The key remains encrypted in PostgreSQL.
AVALAI_ALLOWED_HOSTS=api.avalai.ir
AVALAI_ALLOWED_MODELS=deepseek-v4-flash

ASSISTANT_REQUEST_TIMEOUT_MS=45000
ASSISTANT_MAX_CONCURRENCY=20
