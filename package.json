{
  "name": "new-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "generate-llms": "npm --prefix mdx-to-md-converter ci && npm --prefix mdx-to-md-converter run convert",
    "generate-llms:pre-commit": "npm --prefix mdx-to-md-converter run pre-commit && git add public/llms public/all-links-llms.txt",
    "build": "npm run sitemap && npm run fetch:models && prisma generate && next build",
    "start": "next start",
    "sitemap": "node sitemap/generate.js",
    "fetch:models": "node src/scripts/fetch-liara-ai-models.js",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "prepare": "npx husky install || echo husky skipped"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@liara/platformicons": "^3.13.0",
    "@mdx-js/loader": "^3.0.1",
    "@mdx-js/react": "^3.0.1",
    "@prisma/client": "^5.22.0",
    "antd": "^5.21.0",
    "argon2": "^0.41.1",
    "@next/mdx": "^16.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "husky": "^9.1.7",
    "jsonwebtoken": "^9.0.2",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^1.33.0",
    "meilisearch": "^0.41.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-highlight": "^0.15.0",
    "react-icons": "^5.2.1",
    "recharts": "^2.13.0",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ua-parser-js": "^1.0.38",
    "yet-another-react-lightbox": "^3.23.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.2",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.3"
  },
  "packageManager": "npm@12.0.2"
}
